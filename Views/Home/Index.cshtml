@model ProductsListViewModel

@* determine route name based on category selection *@
@{
    var route = this.Model.CurrentCategory is null ? "pagination" : "categoryPage";
}


@foreach (var p in Model?.Products ?? Enumerable.Empty<Product>())
{
    // partial view for product display
    <partial name="_ProductSummary" model="p"/>
}

@* HTML attribute binding *@
@* Razor sees page-action="Index" in the HTML,  
converts the kebab-case attribute name to PascalCase (PageAction),
finds the matching property on your class, and assigns the value *@

<!-- page-route        → maps to PageRoute property   → tells RouteUrl() which route template to use -->
<!-- page-url-category → collected into PageUrlValues → { ["category"] = "Basketball" } -->
<!-- page-url-* prefix → Razor strips prefix and adds key-value pair to PageUrlValues dictionary automatically -->
<div page-model="@Model?.PageInfo"
     page-classes-enabled="true"
     page-route="@route"
     page-class="btn"
     page-class-normal="btn-outline-dark"
     page-class-selected="btn-primary"
     page-url-category="@Model?.CurrentCategory!"
     class="btn-group pull-right m-1">
</div>
